# Local development secrets. Copy to .env; never commit .env.
# Values below are development-only placeholders.

POSTGRES_PASSWORD=postgres-dev

VERITRACE_CORE_OWNER_PASSWORD=core-owner-dev
VERITRACE_CORE_APP_PASSWORD=core-app-dev
VERITRACE_TELEMETRY_OWNER_PASSWORD=telemetry-owner-dev
VERITRACE_TELEMETRY_APP_PASSWORD=telemetry-app-dev
VERITRACE_RELAYER_OWNER_PASSWORD=relayer-owner-dev
VERITRACE_RELAYER_APP_PASSWORD=relayer-app-dev

# Access token signing keys of core-business-service: <kid>:<base64 of 32 random bytes>, comma-separated; the
# first one signs. Generate a key with `openssl rand -base64 32`.
VERITRACE_CORE_JWT_SIGNING_KEYS=dev-2026-09:bG9jYWwtZGV2ZWxvcG1lbnQtc2lnbmluZy1rZXktMDE=

MQTT_INGEST_PASSWORD=ingest-dev
MQTT_SIMULATOR_PASSWORD=simulator-dev

REDIS_PASSWORD=redis-dev

# Host ports. Change them if another local stack already uses the defaults.
POSTGRES_HOST_PORT=5432
KAFKA_HOST_PORT=9092
MQTT_HOST_PORT=1883
REDIS_HOST_PORT=6379
GATEWAY_HOST_PORT=8000
DASHBOARD_HOST_PORT=8001
PWA_HOST_PORT=8002
PORTAL_HOST_PORT=8003

# Gateway upstreams. Defaults target services running on the host.
# `make up-apps` switches them to the containers of the "apps" profile.
# GATEWAY_CORE_UPSTREAM=host.docker.internal:8080
# GATEWAY_TELEMETRY_UPSTREAM=host.docker.internal:8090
# GATEWAY_RELAYER_UPSTREAM=host.docker.internal:8100
# Frontend dev servers on the host (ADR-0021).
# GATEWAY_DASHBOARD_UPSTREAM=host.docker.internal:3001
# GATEWAY_PWA_UPSTREAM=host.docker.internal:3002
# GATEWAY_PORTAL_UPSTREAM=host.docker.internal:3003
